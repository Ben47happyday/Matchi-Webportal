# Postgres connection string for order storage (tables live in their own
# "matchihomeware" schema, so this can safely be the same Supabase project
# other Zcube solutions use). Required even for local dev.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Microsoft Graph app-only credentials used to SEND order notification
# emails — the same ones already configured on the naplan-prep-hub Render
# service for the Zcube contact form (see Naplan-Portal/backend/app.py).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=orders@zcube.com.au

# Who receives the order notification emails
NOTIFY_EMAIL=you@yourcompany.com

# Password for the /admin orders dashboard
ADMIN_PASSWORD=change-this-password

# Leave unset for local dev (app serves at /). In production this is
# "/solutions/matchihomeware" — see render.yaml.
NEXT_PUBLIC_BASE_PATH=
